# Copia este archivo a .env y completa los valores reales.
# .env nunca se sube al repositorio (ver .gitignore).

# PostgreSQL (debe tener la extensión PostGIS habilitada — ver prisma/POSTGIS_NOTAS.md)
DATABASE_URL="postgresql://usuario:password@localhost:5432/sigop?schema=public"

# JWT
JWT_ACCESS_SECRET="cambia-este-valor-por-uno-largo-y-aleatorio"
JWT_REFRESH_SECRET="cambia-este-otro-valor-tambien"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Subida de archivos — dentro de public/ para que Next.js la sirva
# directamente (una carpeta fuera de public/ no es accesible desde la web).
# En producción, Nginx/IIS puede servir esta misma ruta directo del disco.
UPLOADS_DIR="./public/uploads"

# URL pública del sitio (usada en enlaces de compartir, QR, correos)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
