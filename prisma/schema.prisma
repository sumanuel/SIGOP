// ObraVisible — Schema de base de datos
// Convención: igual que tienda-web/backend/prisma/schema.prisma
//   - ids uuid, campos en camelCase, tablas mapeadas a snake_case (@@map)
//   - índices explícitos por FK y por patrones de consulta frecuentes
//
// Diferencia clave: los campos de geolocalización usan Unsupported("geometry...")
// porque Prisma no tiene un tipo nativo para PostGIS. Ver notas al final del archivo.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ========================================
// ENUMS
// ========================================

enum EstadoPublicacion {
  BORRADOR
  EN_REVISION
  PUBLICADO
}

enum RolUsuario {
  SUPER_ADMIN
  ADMIN_ENTE
  EDITOR_OBRA
  APROBADOR
  CONSULTA
}

enum TipoMultimedia {
  IMAGEN
  VIDEO
  DOCUMENTO
}

enum EtapaMultimedia {
  ANTES
  DURANTE
  DESPUES
}

enum EstadoModeracion {
  PENDIENTE
  APROBADO
  RECHAZADO
}

enum ModalidadContratacion {
  LICITACION_GENERAL
  LICITACION_SELECTIVA
  CONTRATACION_DIRECTA
  CONSULTA_PRECIOS
}

enum EstadoDenuncia {
  RECIBIDA
  EN_REVISION
  DERIVADA_CONTRALORIA
  CERRADA
}

enum TipoAlerta {
  SIN_ACTUALIZACION // obra en ejecución sin un nuevo avance en muchos días
  DESFASE_FINANCIERO // avance financiero muy por encima del físico
  VENCIMIENTO_PROXIMO // se acerca la fecha de fin estimada con poco avance
  OBRA_VENCIDA // pasó la fecha de fin estimada y no está culminada
  PARALIZADA_PROLONGADA // paralizada por mucho tiempo
}

enum MotivoParalizacion {
  FALTA_PRESUPUESTO
  INCUMPLIMIENTO_CONTRATISTA
  PROBLEMA_LEGAL_PERMISOS
  PROBLEMA_TECNICO
  CONDICIONES_CLIMATICAS
  ORDEN_SUPERIOR
  OTRO
}

// ========================================
// TERRITORIO (con límites geográficos PostGIS)
// ========================================

model Estado {
  id        String                                       @id @default(uuid())
  nombre    String                                       @unique
  codigo    String                                       @unique
  // Polígono del límite del estado, usado para "obras dentro de este estado"
  geometria Unsupported("geometry(MultiPolygon, 4326)")?
  createdAt DateTime                                     @default(now())
  updatedAt DateTime                                     @updatedAt

  municipios Municipio[]
  obras      Obra[]
  usuarios   Usuario[]

  @@map("estados")
}

model Municipio {
  id        String                                       @id @default(uuid())
  nombre    String
  estadoId  String
  geometria Unsupported("geometry(MultiPolygon, 4326)")?
  createdAt DateTime                                     @default(now())
  updatedAt DateTime                                     @updatedAt

  estado     Estado      @relation(fields: [estadoId], references: [id], onDelete: Restrict)
  parroquias Parroquia[]
  obras      Obra[]

  @@unique([estadoId, nombre])
  @@index([estadoId])
  @@map("municipios")
}

model Parroquia {
  id          String                                       @id @default(uuid())
  nombre      String
  municipioId String
  geometria   Unsupported("geometry(MultiPolygon, 4326)")?
  createdAt   DateTime                                     @default(now())
  updatedAt   DateTime                                     @updatedAt

  municipio Municipio @relation(fields: [municipioId], references: [id], onDelete: Restrict)
  obras     Obra[]

  @@unique([municipioId, nombre])
  @@index([municipioId])
  @@map("parroquias")
}

// ========================================
// CATÁLOGOS
// ========================================

model TipoObra {
  id        String   @id @default(uuid())
  nombre    String   @unique // Salud, Educación, Vialidad, Vivienda, Agua, Electricidad...
  icono     String?
  color     String?
  createdAt DateTime @default(now())

  obras Obra[]

  @@map("tipos_obra")
}

model EstatusObra {
  id        String   @id @default(uuid())
  nombre    String   @unique // Planificada, En ejecución, Paralizada, Culminada, Inaugurada
  color     String?
  orden     Int      @default(0)
  createdAt DateTime @default(now())

  obras Obra[]

  @@map("estatus_obra")
}

model Ente {
  id        String   @id @default(uuid())
  nombre    String   @unique
  siglas    String?
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  obras    Obra[]
  usuarios Usuario[]

  @@map("entes")
}

model Contratista {
  id          String   @id @default(uuid())
  razonSocial String   @unique
  rif         String?  @unique
  contacto    String?
  telefono    String?
  email       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  obras     Obra[]
  contratos Contrato[]

  @@map("contratistas")
}

model FuenteFinanciamiento {
  id        String   @id @default(uuid())
  nombre    String   @unique
  createdAt DateTime @default(now())

  obras Obra[]

  @@map("fuentes_financiamiento")
}

model Cargo {
  id              String   @id @default(uuid())
  nombre          String   @unique // Jefe de obra, Ingeniero residente, Obrero, Personal de limpieza...
  nivelJerarquico Int      @default(0) // 1 = más alto en el organigrama
  area            String?
  createdAt       DateTime @default(now())

  asignaciones ObraPersonal[]

  @@map("cargos")
}

// ========================================
// OBRAS
// ========================================

model Obra {
  id          String  @id @default(uuid())
  codigo      String  @unique // OBR-2026-00123
  slug        String  @unique
  nombre      String
  descripcion String?

  tipoObraId              String
  estatusId               String
  enteId                  String
  contratistaId           String?
  fuenteFinanciamientoId  String?
  partidaPresupuestariaId String?

  estadoId    String
  municipioId String
  parroquiaId String?
  direccion   String?

  // Punto principal de la obra (hospital, escuela) — usado en los marcadores del mapa
  ubicacion Unsupported("geometry(Point, 4326)")?
  // Trazado opcional para obras lineales o de área (carreteras, tuberías, urbanismos)
  trazado   Unsupported("geometry(Geometry, 4326)")?

  // Decimal en vez de Float (a diferencia de tienda-web) para evitar errores de
  // redondeo en montos grandes de presupuesto público.
  presupuestoAprobado Decimal @default(0) @db.Decimal(18, 2)
  montoEjecutado      Decimal @default(0) @db.Decimal(18, 2)
  moneda              String  @default("VES")

  fechaAprobacion  DateTime?
  fechaInicio      DateTime?
  fechaFinEstimada DateTime?
  fechaFinReal     DateTime?

  avanceFisico     Float @default(0) // 0-100
  avanceFinanciero Float @default(0) // 0-100

  beneficiarios        Int?
  capacidadDescripcion String? // "120 camas", "800 estudiantes", "14 km"

  destacada         Boolean           @default(false)
  estadoPublicacion EstadoPublicacion @default(BORRADOR)

  creadoPor      String?
  actualizadoPor String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tipoObra              TipoObra               @relation(fields: [tipoObraId], references: [id], onDelete: Restrict)
  estatus               EstatusObra            @relation(fields: [estatusId], references: [id], onDelete: Restrict)
  ente                  Ente                   @relation(fields: [enteId], references: [id], onDelete: Restrict)
  contratista           Contratista?           @relation(fields: [contratistaId], references: [id], onDelete: SetNull)
  fuenteFinanciamiento  FuenteFinanciamiento?  @relation(fields: [fuenteFinanciamientoId], references: [id], onDelete: SetNull)
  partidaPresupuestaria PartidaPresupuestaria? @relation(fields: [partidaPresupuestariaId], references: [id], onDelete: SetNull)
  estado                Estado                 @relation(fields: [estadoId], references: [id], onDelete: Restrict)
  municipio             Municipio              @relation(fields: [municipioId], references: [id], onDelete: Restrict)
  parroquia             Parroquia?             @relation(fields: [parroquiaId], references: [id], onDelete: SetNull)

  avances              Avance[]
  historialPresupuesto HistorialPresupuesto[]
  hitos                Hito[]
  multimedia           Multimedia[]
  personal             ObraPersonal[]
  reportesCiudadanos   ReporteCiudadano[]
  paralizaciones       PeriodoParalizacion[]
  alertas              Alerta[]
  denuncias            Denuncia[]
  contrato             Contrato?
  suscripciones        Suscripcion[]

  @@index([estatusId])
  @@index([tipoObraId])
  @@index([estadoId])
  @@index([municipioId])
  @@index([estadoPublicacion])
  @@index([destacada])
  @@index([createdAt(sort: Desc)])
  @@map("obras")
}

// Historial de paralizaciones de una obra (MODULOS_AVANZADOS.md, módulo 2): una
// obra puede detenerse varias veces; cada periodo guarda el motivo y las
// fechas exactas. `fechaReactivacion` es null mientras sigue paralizada.
model PeriodoParalizacion {
  id                  String             @id @default(uuid())
  obraId              String
  motivo              MotivoParalizacion
  descripcion         String?
  fechaInicio         DateTime
  fechaReactivacion   DateTime?
  responsableRegistro String? // id del usuario que la registró (suelto, como en la bitácora)
  createdAt           DateTime           @default(now())

  obra Obra @relation(fields: [obraId], references: [id], onDelete: Cascade)

  @@index([obraId])
  @@index([motivo])
  @@map("periodos_paralizacion")
}

// Alertas de gestión (MODULOS_AVANZADOS.md, módulo 3): las genera un motor de
// reglas (alertas.service.ts), a lo sumo una sin resolver por obra y tipo.
// Se resuelven solas cuando la condición desaparece, o a mano (`resueltaPor`).
model Alerta {
  id          String     @id @default(uuid())
  obraId      String
  tipo        TipoAlerta
  severidad   Int        @default(1) // 1 = informativa, 2 = advertencia, 3 = crítica
  mensaje     String
  resuelta    Boolean    @default(false)
  resueltaPor String? // id del usuario; null si se resolvió sola (la condición desapareció)
  resueltaEn  DateTime?
  createdAt   DateTime   @default(now())

  obra Obra @relation(fields: [obraId], references: [id], onDelete: Cascade)

  @@index([obraId])
  @@index([tipo, resuelta])
  @@map("alertas")
}

// Cadena de sellos de integridad (MODULOS_AVANZADOS.md, módulo 6): cada vez que
// se registra un avance se agrega un registro cuyo hash incluye el contenido y
// el hash del registro anterior (como un libro contable encadenado). Si alguien
// edita un dato o un registro viejo directamente en la base, la verificación lo
// detecta. `datos` guarda el contenido sellado para poder recalcular cada hash.
model RegistroIntegridad {
  id           String   @id @default(uuid())
  secuencia    Int      @unique @default(autoincrement()) // orden estricto de la cadena
  entidad      String // "Avance"
  entidadId    String
  obraId       String // para verificar por obra sin recorrer la cadena completa
  accion       String // CREAR
  datos        Json
  datosHash    String // SHA-256 de (contenido canónico + hashAnterior)
  hashAnterior String
  createdAt    DateTime @default(now())

  @@index([entidad, entidadId])
  @@index([obraId])
  @@map("registro_integridad")
}

// Canal de denuncia ciudadana (MODULOS_AVANZADOS.md, módulo 4). Diseñado para
// proteger a quien denuncia: no se guarda IP ni agente de navegador, el código de
// seguimiento solo existe en claro una vez (aquí queda su hash), y el contacto,
// opcional, se cifra en reposo.
model Denuncia {
  id              String         @id @default(uuid())
  numero          Int            @unique @default(autoincrement()) // referencia interna; nunca se muestra al público
  obraId          String?
  codigoHash      String         @unique // SHA-256 del código de seguimiento
  esAnonima       Boolean        @default(true)
  contactoCifrado String?
  categoria       String
  descripcion     String
  evidenciaUrl    String?
  estado          EstadoDenuncia @default(RECIBIDA)
  derivadaA       String? // organismo al que se envió
  createdAt       DateTime       @default(now())
  actualizadoEn   DateTime       @updatedAt

  obra    Obra?            @relation(fields: [obraId], references: [id], onDelete: SetNull)
  eventos EventoDenuncia[]

  @@index([estado])
  @@index([obraId])
  @@map("denuncias")
}

// Historial de estados de una denuncia; `nota` es un mensaje para el denunciante
// (visible con su código de seguimiento).
model EventoDenuncia {
  id         String         @id @default(uuid())
  denunciaId String
  estado     EstadoDenuncia
  nota       String?
  createdAt  DateTime       @default(now())

  denuncia Denuncia @relation(fields: [denunciaId], references: [id], onDelete: Cascade)

  @@index([denunciaId])
  @@map("eventos_denuncia")
}

// Contratación de una obra (MODULOS_AVANZADOS.md, módulo 1): cómo se contrató,
// cuánto costó el contrato original y qué modificaciones tuvo. El contrato
// original no se sobrescribe: los cambios de monto y plazo son adendas.
model Contrato {
  id                 String                @id @default(uuid())
  obraId             String                @unique // 1 obra ↔ 1 contrato principal
  contratistaId      String
  numeroContrato     String                @unique
  modalidad          ModalidadContratacion
  moneda             String                @default("VES")
  montoOriginal      Decimal               @db.Decimal(18, 2)
  montoActual        Decimal               @db.Decimal(18, 2) // cambia solo con adendas
  fechaFirma         DateTime
  plazoEjecucionDias Int
  documentoUrl       String?
  creadoPor          String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  obra        Obra             @relation(fields: [obraId], references: [id], onDelete: Cascade)
  contratista Contratista      @relation(fields: [contratistaId], references: [id], onDelete: Restrict)
  adendas     ContratoAdenda[]

  @@index([contratistaId])
  @@map("contratos")
}

model ContratoAdenda {
  id              String   @id @default(uuid())
  contratoId      String
  numero          Int // Adenda N.º 1, 2…
  motivo          String
  montoAnterior   Decimal  @db.Decimal(18, 2)
  montoNuevo      Decimal  @db.Decimal(18, 2)
  diasAdicionales Int      @default(0)
  documentoUrl    String?
  registradoPor   String?
  fecha           DateTime @default(now())

  contrato Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)

  @@unique([contratoId, numero])
  @@map("contrato_adendas")
}

model Avance {
  id               String    @id @default(uuid())
  obraId           String
  fecha            DateTime  @default(now())
  avanceFisico     Float
  avanceFinanciero Float
  comentario       String?
  registradoPor    String?
  aprobadoPor      String?
  aprobadoEn       DateTime?
  createdAt        DateTime  @default(now())

  obra       Obra         @relation(fields: [obraId], references: [id], onDelete: Cascade)
  multimedia Multimedia[]

  @@index([obraId, fecha(sort: Desc)])
  @@map("avances")
}

model Hito {
  id               String    @id @default(uuid())
  obraId           String
  nombre           String
  fechaPlanificada DateTime?
  fechaReal        DateTime?
  completado       Boolean   @default(false)
  orden            Int       @default(0)
  createdAt        DateTime  @default(now())

  obra Obra @relation(fields: [obraId], references: [id], onDelete: Cascade)

  @@index([obraId])
  @@map("hitos")
}

model Multimedia {
  id           String           @id @default(uuid())
  obraId       String
  avanceId     String?
  tipo         TipoMultimedia   @default(IMAGEN)
  url          String
  miniaturaUrl String?
  titulo       String?
  etapa        EtapaMultimedia?
  esPortada    Boolean          @default(false)
  orden        Int              @default(0)
  fechaCaptura DateTime? // fecha EXIF de la foto, evidencia de campo
  latitudExif  Float?
  longitudExif Float?
  createdAt    DateTime         @default(now())

  obra   Obra    @relation(fields: [obraId], references: [id], onDelete: Cascade)
  avance Avance? @relation(fields: [avanceId], references: [id], onDelete: SetNull)

  @@index([obraId])
  @@index([avanceId])
  @@map("multimedia")
}

// ========================================
// PERSONAL
// ========================================

model Persona {
  id                        String    @id @default(uuid())
  nombres                   String
  apellidos                 String
  fotoUrl                   String?
  profesion                 String?
  especialidad              String?
  aniosExperiencia          Int?
  bioCorta                  String?
  // Privado: nunca se expone en la API pública, solo uso administrativo/legal.
  documentoIdentidad        String?
  consentimientoPublicacion Boolean   @default(false)
  fechaConsentimiento       DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  asignaciones ObraPersonal[]

  @@index([apellidos, nombres])
  @@map("personas")
}

model ObraPersonal {
  id             String    @id @default(uuid())
  obraId         String
  personaId      String
  cargoId        String
  area           String? // cuadrilla o área dentro de la obra
  supervisorId   String? // apunta a otro registro ObraPersonal (jerarquía en el organigrama)
  fechaIngreso   DateTime?
  fechaSalida    DateTime?
  visiblePublico Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  obra         Obra           @relation(fields: [obraId], references: [id], onDelete: Cascade)
  persona      Persona        @relation(fields: [personaId], references: [id], onDelete: Cascade)
  cargo        Cargo          @relation(fields: [cargoId], references: [id], onDelete: Restrict)
  supervisor   ObraPersonal?  @relation("Jerarquia", fields: [supervisorId], references: [id], onDelete: SetNull)
  subordinados ObraPersonal[] @relation("Jerarquia")

  @@unique([obraId, personaId, cargoId])
  @@index([obraId])
  @@index([personaId])
  @@index([supervisorId])
  @@map("obra_personal")
}

// ========================================
// SISTEMA (usuarios, auditoría, participación ciudadana)
// ========================================

model Usuario {
  id                  String     @id @default(uuid())
  email               String     @unique
  password            String
  nombre              String
  rol                 RolUsuario @default(CONSULTA)
  twoFactorSecret     String?
  activo              Boolean    @default(true)
  enteId              String?
  estadoRestriccionId String? // si se define, el usuario solo ve obras de este estado
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  ente              Ente?   @relation(fields: [enteId], references: [id], onDelete: SetNull)
  estadoRestriccion Estado? @relation(fields: [estadoRestriccionId], references: [id], onDelete: SetNull)

  @@index([enteId])
  @@index([estadoRestriccionId])
  @@map("usuarios")
}

model Auditoria {
  id           String   @id @default(uuid())
  usuarioId    String?
  accion       String // CREATE, UPDATE, DELETE, PUBLISH, APPROVE...
  entidad      String // "Obra", "Persona", "Avance"...
  entidadId    String
  datosAntes   Json?
  datosDespues Json?
  ip           String?
  createdAt    DateTime @default(now())

  @@index([entidad, entidadId])
  @@index([usuarioId])
  @@index([createdAt(sort: Desc)])
  @@map("auditoria")
}

model ReporteCiudadano {
  id               String           @id @default(uuid())
  obraId           String
  nombre           String?
  correo           String?
  mensaje          String
  fotoUrl          String?
  estadoModeracion EstadoModeracion @default(PENDIENTE)
  moderadoPor      String?
  moderadoEn       DateTime?
  createdAt        DateTime         @default(now())

  obra Obra @relation(fields: [obraId], references: [id], onDelete: Cascade)

  @@index([obraId])
  @@index([estadoModeracion])
  @@map("reportes_ciudadanos")
}

model Suscripcion {
  id                String   @id @default(uuid())
  obraId            String
  correo            String
  confirmado        Boolean  @default(false)
  tokenConfirmacion String?  @unique
  createdAt         DateTime @default(now())

  obra Obra @relation(fields: [obraId], references: [id], onDelete: Cascade)

  @@unique([obraId, correo])
  @@index([obraId])
  @@map("suscripciones")
}

// ========================================
// PRESUPUESTO POR PARTIDAS (MODULOS_AVANZADOS.md, módulo 10)
// ========================================

// Código presupuestario oficial (Ley de Presupuesto u ordenanza) que respalda la obra.
model PartidaPresupuestaria {
  id              String   @id @default(uuid())
  codigo          String   @unique // ej. "301-01-02-15"
  descripcion     String
  ejercicioFiscal Int // año
  createdAt       DateTime @default(now())

  obras Obra[]

  @@map("partidas_presupuestarias")
}

// Cada modificación del presupuesto aprobado de una obra, con su justificación.
model HistorialPresupuesto {
  id            String   @id @default(uuid())
  obraId        String
  montoAnterior Decimal  @db.Decimal(18, 2)
  montoNuevo    Decimal  @db.Decimal(18, 2)
  moneda        String
  motivo        String
  documentoUrl  String?
  registradoPor String? // id del usuario (suelto, como en la bitácora)
  fecha         DateTime @default(now())

  obra Obra @relation(fields: [obraId], references: [id], onDelete: Cascade)

  @@index([obraId])
  @@map("historial_presupuesto")
}
